---

<header class="custom-starlight-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo-link" aria-label="Home">
      <img src="/images/cclogo.svg" alt="Coela Can't!" class="logo" />
    </a>
    
    <!-- Navigation Links -->
    <nav class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
    
    <!-- Right side: Social icons + Search -->
    <div class="header-right">
      <div class="social-icons">
        {socialLinks.map((social) => (
          <a 
            href={social.href} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="social-icon"
            title={social.label}
            set:html={icons[social.icon]}
          />
        ))}
      </div>
      <div class="search-wrapper">
        <Search />
      </div>
    </div>
  </div>
</header>

<style>
  .custom-starlight-header {
    border-bottom: 1px solid rgba(248, 160, 194, 0.2);
    background: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    max-width: 90rem;
    margin: 0 auto;
    gap: 1rem;
  }
  
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  
  .logo {
    height: 1.75rem;
    width: auto;
    filter: invert(73%) sepia(20%) saturate(749%) hue-rotate(295deg) brightness(101%) contrast(95%);
  }
  
  .nav-links {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  
  .nav-link {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    color: rgba(245, 245, 245, 0.8);
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 0.9rem;
    white-space: nowrap;
    line-height: 1;
    display: flex;
    align-items: center;
  }
  
  .nav-link:hover {
    color: #f8a0c2;
    background: rgba(248, 160, 194, 0.1);
  }
  
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  
  .social-icons {
    display: flex;
    gap: 0.25rem;
  }
  
  .social-icon {
    padding: 0.5rem;
    color: rgba(245, 245, 245, 0.6);
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .social-icon:hover {
    color: #f8a0c2;
    background: rgba(248, 160, 194, 0.1);
  }
  
  .search-wrapper {
    min-width: 180px;
  }
  
  /* Override Starlight search styling */
  .search-wrapper :global(button) {
    background: rgba(248, 160, 194, 0.1) !important;
    border: 1px solid rgba(248, 160, 194, 0.3) !important;
  }
  
  .search-wrapper :global(button:hover) {
    background: rgba(248, 160, 194, 0.2) !important;
    border-color: rgba(248, 160, 194, 0.5) !important;
  }
  
  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
    }
    
    .nav-links {
      justify-content: center;
      order: 1;
    }
    
    .header-right {
      order: 0;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
