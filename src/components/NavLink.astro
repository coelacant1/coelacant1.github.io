---
interface Props {
  href: string;
  label: string;
  external?: boolean;
}

const { href, label, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="px-4 py-2 rounded-lg text-text-light/80 hover:text-primary hover:bg-primary/10 transition-all duration-200"
>
  {label}
</a>
