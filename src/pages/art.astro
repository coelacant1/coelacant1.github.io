];
---

<BaseLayout title="Art Gallery - Coela Can't!">
  <div class="min-h-screen flex flex-col">
    <SiteHeader />

    {!features.art ? (
      <main class="flex-1 px-4 py-24 flex items-center justify-center">
        <div class="max-w-xl text-center bg-surface/30 border border-primary/20 rounded-xl p-10">
          <h1 class="text-3xl md:text-4xl font-bold text-primary mb-4">Art Gallery — Coming Soon</h1>
          <p class="text-white/70">This section is temporarily unavailable while it's being updated. Please check back soon!</p>
          <a href="/" class="inline-block mt-6 px-5 py-2 rounded-lg bg-primary/20 border border-primary/40 text-primary hover:bg-primary/30 transition-colors">← Back to Home</a>
        </div>
      </main>
    ) : (
    <main class="flex-1 px-4 py-12">
      <div class="max-w-6xl mx-auto">
        <h1 class="text-4xl font-bold text-primary mb-2 text-center flex items-center justify-center gap-3">
          <Icon name="art" class="w-10 h-10" /> Art Gallery
        </h1>
        <p class="text-text-light/70 mb-4 text-center">
          Check out my artwork! Click to expand.
        </p>
        <p class="text-text-light/60 mb-8 text-center text-sm">
          Art posts go up on <a href="https://twitter.com/coelacant1" class="text-primary hover:underline">X</a> and 
          <a href="https://bsky.app/profile/coelacant1.bsky.social" class="text-primary hover:underline">Bluesky</a>.{features.telegramArt ? (<> NSFW content is only posted on <a href="https://t.me/CoelaCantArt" class="text-primary hover:underline">Telegram</a>.</>) : ''}
        </p>

        <!-- Full Body / Half Body Art Section -->
        <h2 class="text-2xl font-bold text-primary mb-6 mt-4">Full Body / Half Body Art</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {artworks.map((art) => (
            <div 
              class="group relative overflow-hidden rounded-xl bg-bg-card border border-primary/20 hover:border-primary transition-all cursor-pointer"
              data-lightbox={art.src}
              data-title={art.title}
            >
              <img
                src={art.src}
                alt={art.title}
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg-darker/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-lg font-semibold text-primary">{art.title}</h3>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Stickers Section -->
        <h2 class="text-2xl font-bold text-primary mb-6 mt-12">Stickers</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
          {stickers.map((sticker) => (
            <div 
              class="group relative overflow-hidden rounded-xl bg-bg-card border border-primary/20 hover:border-primary transition-all cursor-pointer"
              data-lightbox={sticker.src}
              data-title={sticker.title}
            >
              <img
                src={sticker.src}
                alt={sticker.title}
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg-darker/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-lg font-semibold text-primary">{sticker.title}</h3>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Animations Section -->
        <h2 class="text-2xl font-bold text-primary mb-6 mt-12">Animations</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {animations.map((anim) => (
            <div 
              class="group relative overflow-hidden rounded-xl bg-bg-card border border-primary/20 hover:border-primary transition-all cursor-pointer"
              data-lightbox={anim.src}
              data-title={anim.title}
            >
              <img
                src={anim.src}
                alt={anim.title}
                class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-bg-darker/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                <div class="absolute bottom-0 left-0 right-0 p-4">
                  <h3 class="text-lg font-semibold text-primary">{anim.title}</h3>
                </div>
              </div>
            </div>
          ))}
        </div>


      </div>
    </main>
    )}

    <footer class="py-6 text-center text-text-light/50 border-t border-primary/20">
      © 2026 Coela Can't! All rights reserved.
    </footer>
  </div>
  
  <Lightbox />
</BaseLayout>
