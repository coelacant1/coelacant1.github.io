// Animations, ordered newest first
const animations = [
  { src: '/images/animations/gif-animation-2.gif', title: 'Hertzz Chomp' },
  { src: '/images/animations/gif-animation-1.gif', title: 'Hertzz Chomp Edit' },
  { src: '/images/animations/gif-animation-16.gif', title: 'Coela Nerd' },
  { src: '/images/animations/gif-animation-15.gif', title: 'Coela Blep' },
  { src: '/images/animations/gif-animation-14.gif', title: 'Coela Peek Blep' },
  { src: '/images/animations/gif-animation-13.gif', title: 'Coela Peek' },
  { src: '/images/animations/gif-animation-12.gif', title: 'Coela Sad' },
