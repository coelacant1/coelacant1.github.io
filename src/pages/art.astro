  { src: '/images/stickers/sticker-6.jpg', title: 'Coela Sad' },
  { src: '/images/stickers/sticker-5.jpg', title: 'Hertzz and Coela Hug' },
  { src: '/images/stickers/sticker-4.jpg', title: 'Coela Surprise' },
  { src: '/images/stickers/sticker-3.jpg', title: 'Coela Lick' },
